# Names only. Never commit a filled .env.
PORT=3000
GITHUB_TOKEN=
# Write access to the demo repo. Falls back to GITHUB_TOKEN.
GITHUB_WRITE_TOKEN=
GITHUB_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
DATABASE_URL=
DEMO_REPO=
VAULT_REPO=
# Required on every /findings/* and /mcp request.
FINDINGS_API_KEY=
FRONTEND_ORIGIN=
CHECKS_API_URL=
# Model for the drift check (`claude --model`): alias or full id. Default haiku (fast).
CHECK_MODEL=
