# Names only. Never commit a filled .env.
PORT=8787
# Write access to the demo repo only. Used only by src/actions/github.ts.
GITHUB_WRITE_TOKEN=
# Same key as the findings API (#18). Required on every /findings/* and /mcp request.
FINDINGS_API_KEY=
# Base URL of the findings API (#18) and checks API (#9). Unset = in-memory fake store seeded with fixtures.
FINDINGS_API_URL=
CHECKS_API_URL=
# Repo used by scripts/real-run.ts. Must be the demo repo, never larphacks.
DEMO_REPO=
