# Names only. Never commit a filled .env.
# Local dev: copy to .env.local (gitignored) and run `npm run dev`.
# Production (NODE_ENV=production, set on Render): every required value below must be set
# or the server refuses to start and names the missing one.
PORT=3000
# Postgres. SSL is on automatically for non-local hosts (Render), or with ?sslmode=require / PGSSLMODE=require.
# Local container: postgres://larphacks:larphacks_local@localhost:5433/larphacks
DATABASE_URL=
# Read access to the demo repo and the vault repo.
GITHUB_TOKEN=
# Write access to the demo repo (comments, reopen, commit status).
GITHUB_WRITE_TOKEN=
GITHUB_WEBHOOK_SECRET=
# One of these (CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`) is required.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Required on every /findings/* and /mcp request. Required in every environment.
FINDINGS_API_KEY=
# owner/repo
DEMO_REPO=
VAULT_REPO=
# Optional: allowed browser origin for the Expo web app.
FRONTEND_ORIGIN=
# Model for the drift check (`claude --model`): alias or full id. Default haiku (fast).
CHECK_MODEL=
